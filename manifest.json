{
  "manifest_version": 3,
  "name": "NIF Generator",
  "version": "1.0",
  "description": "Generates valid NIF, NIE, CIF, Codice Fiscale, and Partita IVA and copies them to the clipboard",
  "permissions": ["clipboardWrite", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Generate Document",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["css/styles.css"],
      "js": ["content.js"],
      "all_frames": true
    }
  ], 
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["<all_urls>"]
    }
  ]
}